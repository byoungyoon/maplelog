# Firebase project with the Firestore default database.
FIREBASE_PROJECT_ID=maplelog-3ba66
# On Vercel, store the service account JSON as a server-only environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local auction collection only; keep these off Vercel.
NEXON_AUCTION_ID=
NEXON_AUCTION_PASSWORD=
# At least 32 characters for encrypted HttpOnly API-key login sessions.
SESSION_SECRET=
# Optional fixed public origin, e.g. https://mesolog.example.com.
# When omitted, the request Host and forwarded HTTPS protocol are checked.
APP_ORIGIN=
# 64 hex characters, independent from the database. Required on public deployments.
CREDENTIAL_ENCRYPTION_KEY=
